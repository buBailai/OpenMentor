# QuickForm 任务的报告文件
static/reports/*
!static/reports/.gitkeep

# 学生身份附件等其他上传
static/uploads/*.html
static/uploads/*.pdf
static/uploads/*.docx

# ---------- 日志 / 临时 ----------
*.log
*.tmp
*.bak
