# 复制本文件为 .env 后再修改：
#   cp .env.example .env
# 或者在生产环境通过系统环境变量传入。

# Flask session 加密密钥。请改成一段足够长且随机的字符串。
# 生成方式（任选其一）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -hex 32
SECRET_KEY=please_change_me_to_a_random_long_string

# 版本形态：
# community = 个人开源版（默认，不显示校园管理）
# campus    = 校园版（启用 admin 教师账号管理入口）
OPENMENTOR_EDITION=community
