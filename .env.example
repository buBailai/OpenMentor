# 复制本文件为 .env 后再修改：
#   cp .env.example .env
# 或者在生产环境通过系统环境变量传入。

# Flask session 加密密钥。请改成一段足够长且随机的字符串。
# 生成方式（任选其一）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -hex 32
SECRET_KEY=please_change_me_to_a_random_long_string

# 版本形态：个人开源版默认使用 community。
OPENMENTOR_EDITION=community
